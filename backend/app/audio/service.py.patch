+class LocalTranscriptSpeechToTextProvider:
+    """Transcribes an audio path via a sidecar .txt file if one exists."""
+
+    def transcribe(self, audio: dict[str, Any]) -> dict[str, Any]:
+        transcript_path = audio.get("transcript_path")
+        audio_path = audio.get("audio_path")
+
+        target_path = transcript_path or (audio_path and str(Path(audio_path).with_suffix(".txt")))
+        if not target_path:
+            return UnavailableSpeechToTextProvider().transcribe(audio)
+
+        try:
+            resolved = Path(target_path).resolve()
+            if not resolved.is_relative_to(settings.DATA_DIR.resolve()):
+                return {"status": "rejected", "message": "Path outside data directory"}
+            if not resolved.exists():
+                return UnavailableSpeechToTextProvider().transcribe(audio)
+            
+            text = resolved.read_text(encoding="utf-8").strip()
+            if not text:
+                return UnavailableSpeechToTextProvider().transcribe(audio)
+                
+            return {"status": "ok", "transcript": text, "provider": "sidecar-txt", "language": None}
+        except Exception as e:
+            # any failure in path parsing or permissions gracefully degrade 
+            return UnavailableSpeechToTextProvider().transcribe(audio)
+
